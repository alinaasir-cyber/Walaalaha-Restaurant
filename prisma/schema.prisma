generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CASHIER
  WAITER
  ACCOUNTANT
  CHEF
  STORE_KEEPER
}

enum OrderStatus {
  PENDING
  COOKING
  READY
  SERVED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  EVC_PLUS
  ZAAD
  SAHAL
  PREMIER_BANK
  CARD
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  BILLING
  RESERVED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  phone     String?
  address   String?
  users     User[]
  orders    Order[]
  createdAt DateTime @default(now())
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  phone        String?
  passwordHash String
  role         Role          @default(WAITER)
  branchId     String?
  branch       Branch?       @relation(fields: [branchId], references: [id])
  active       Boolean       @default(true)
  sessions     CashSession[]
  ordersTaken  Order[]       @relation("WaiterOrders")
  ordersCashier Order[]      @relation("CashierOrders")
  auditLogs    AuditLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Category {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  nameSomali  String
  menuItems   MenuItem[]
  createdAt   DateTime   @default(now())
}

model MenuItem {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  nameSomali  String
  price       Decimal     @db.Decimal(10, 2)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  available   Boolean     @default(true)
  image       String?
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model RestaurantTable {
  id          String      @id @default(uuid())
  number      String      @unique
  section     String
  capacity    Int         @default(4)
  status      TableStatus @default(AVAILABLE)
  orders      Order[]
  createdAt   DateTime    @default(now())
}

model CashSession {
  id            String    @id @default(uuid())
  sessionNumber String    @unique
  cashierId     String
  cashier       User      @relation(fields: [cashierId], references: [id])
  openingFloat  Decimal   @default(0) @db.Decimal(10, 2)
  totalSales    Decimal   @default(0) @db.Decimal(10, 2)
  status        String    @default("ACTIVE") // ACTIVE, CLOSED
  startTime     DateTime  @default(now())
  endTime       DateTime?
  orders        Order[]
}

model Order {
  id            String          @id @default(uuid())
  orderNumber   String          @unique
  type          String          @default("DINE_IN") // DINE_IN, TAKEAWAY, DELIVERY
  tableId       String?
  table         RestaurantTable? @relation(fields: [tableId], references: [id])
  waiterId      String?
  waiter        User?           @relation("WaiterOrders", fields: [waiterId], references: [id])
  cashierId     String?
  cashier       User?           @relation("CashierOrders", fields: [cashierId], references: [id])
  sessionId     String?
  session       CashSession?    @relation(fields: [sessionId], references: [id])
  branchId      String?
  branch        Branch?         @relation(fields: [branchId], references: [id])
  subtotal      Decimal         @db.Decimal(10, 2)
  taxAmount     Decimal         @default(0) @db.Decimal(10, 2)
  totalAmount   Decimal         @db.Decimal(10, 2)
  status        OrderStatus     @default(PENDING)
  notes         String?
  orderItems    OrderItem[]
  payments      Payment[]
  stockDeductions StockDeduction[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model OrderItem {
  id          String    @id @default(uuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id])
  quantity    Int       @default(1)
  unitPrice   Decimal   @db.Decimal(10, 2)
  lineTotal   Decimal   @db.Decimal(10, 2)
  notes       String?
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        PaymentMethod @default(CASH)
  amount        Decimal       @db.Decimal(10, 2)
  referenceCode String?
  status        String        @default("COMPLETED")
  createdAt     DateTime      @default(now())
}

model StockItem {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  unit            String           // kg, pcs, bags, liters
  currentQuantity Decimal          @default(0) @db.Decimal(10, 2)
  minQuantity     Decimal          @default(10) @db.Decimal(10, 2)
  costPerUnit     Decimal          @default(0) @db.Decimal(10, 2)
  deductions      StockDeduction[]
  createdAt       DateTime         @default(now())
}

model StockDeduction {
  id              String     @id @default(uuid())
  orderId         String
  order           Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stockItemId     String
  stockItem       StockItem  @relation(fields: [stockItemId], references: [id])
  quantity        Decimal    @db.Decimal(10, 2)
  createdAt       DateTime   @default(now())
}

model Account {
  id           String        @id @default(uuid())
  code         String        @unique
  name         String
  nameSomali   String?
  type         AccountType
  balance      Decimal       @default(0) @db.Decimal(14, 2)
  journalLines JournalLine[]
  createdAt    DateTime      @default(now())
}

model JournalEntry {
  id          String        @id @default(uuid())
  entryNumber String        @unique
  reference   String?
  date        DateTime      @default(now())
  description String
  lines       JournalLine[]
  createdAt   DateTime      @default(now())
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Decimal      @default(0) @db.Decimal(12, 2)
  credit         Decimal      @default(0) @db.Decimal(12, 2)
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail  String?
  userRole   String?
  action     String   // e.g., "CREATE_ORDER", "VOID_ORDER", "POST_JOURNAL", "LOGIN"
  entityType String   // e.g., "ORDER", "SESSION", "JOURNAL"
  entityId   String?
  details    String?  // JSON stringified summary of changes
  ipAddress  String?
  createdAt  DateTime @default(now())
}
